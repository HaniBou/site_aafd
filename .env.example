# Copier ce fichier en .env.local et remplir les valeurs.
# Les mêmes variables doivent être déclarées dans Vercel > Settings > Environment Variables.
# Ne jamais commiter .env.local.

# --- Site ---------------------------------------------------------------
# URL publique du site, sans slash final.
NEXT_PUBLIC_SITE_URL=https://www.entraide-aafd-valdesaone.fr

# --- Référencement ------------------------------------------------------
# Facultatif. Google Search Console > Ajouter une propriété > Balise HTML :
# coller ici uniquement la valeur du content, pas la balise entière.
# Laisser vide si la propriété est vérifiée par le DNS.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# --- Firebase (client, clés publiques) ----------------------------------
# Firebase Console > Paramètres du projet > Vos applications > Config SDK
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Firebase Admin (serveur, SECRET) -----------------------------------
# Firebase Console > Paramètres > Comptes de service > Générer une clé privée
# FIREBASE_PRIVATE_KEY : garder les guillemets et les \n littéraux.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# --- Session admin (SECRET) ---------------------------------------------
# 32 caractères minimum. Générer avec : openssl rand -base64 32
ADMIN_SESSION_SECRET=

# --- Cloudinary ---------------------------------------------------------
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=
# Nécessaires pour supprimer les images quand on supprime un plat/actualité.
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Resend (emails, SECRET) --------------------------------------------
# Le domaine d'expédition doit être vérifié dans Resend, sinon les envois
# échouent en 403 vers toute adresse autre que celle du compte.
RESEND_API_KEY=
